# Postgres connection. On Vercel, the Neon or Supabase integration sets DATABASE_URL (or POSTGRES_URL) for you.
# The app switches to the non-login role foodlg_app in every transaction, so row-level security always applies.
DATABASE_URL=postgres://postgres@localhost:5432/foodlg
# Local only: used by `npm run db:reset` and tests. Never set on Vercel.
ADMIN_DATABASE_URL=postgres://postgres@localhost:5432/foodlg
# Random string, 32+ characters
SESSION_SECRET=
# Hosted only: one-time token for POST /api/setup (loads the schema and synthetic data). Remove after setup.
SETUP_TOKEN=
